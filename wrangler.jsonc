{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lyroo-rummikub",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-16",
  "observability": { "enabled": true },
  // El subdominio de workers.dev sigue activo como respaldo: si el dominio
  // propio se cae o cambia de manos, las mesas abiertas siguen jugándose.
  "workers_dev": true,
  "routes": [{ "pattern": "rummikub.andrewgarcia.dev", "custom_domain": true }],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "GAME_ROOM", "class_name": "GameRoom" }]
  },
  // Cada sala nueva arranca un Durable Object, y el plan gratuito da 100.000
  // peticiones al día: un script podría agotarlo en minutos. Crear salas se
  // limita por dirección de origen. Treinta por minuto es un número que nadie
  // alcanza montando partidas y que corta en seco cualquier bucle.
  "ratelimits": [
    {
      "name": "ROOM_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }]
}
